class animal{
  void eat()
  {
     System.out.println("Animals are eating");
  }
  void sleep()
  {
    System.out.println("Animals are sleep");
  }
}
class dog extends animal
{
  void dss()
  {
    System.out.println("Dogs are sound");
  }
}

public class Main{
  public static void main(String[]args)
  {
    dog b=new dog();
    b.eat();
    b.dss();
  }
}

