class cal{
  int add(int a,int b)
  {
    return a+b;
  }
  int add(int a,int b,int c)
  {
    return a+b+c;
  }
}
public class Main{
  public static void main(String[]args)
  {
    cal b=new cal();
    System.out.println(b.add(10,20));
    System.out.print(b.add(10,20,30));
  }
}
